            "s3"
          ],
          "tier": "B",
          "authority_label": "fact"
        },
        {
          "id": "c5",
          "field": "history.variant",
          "text": "Bulbapedia lists Dark Raichu as 83/82, and the local/API catalog rows preserve that over-numbered Secret Rare structure as Team Rocket's 83rd card.",
