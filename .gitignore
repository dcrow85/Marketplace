runs/**/*.jsonl
runs/**/*.png
runs/**/*.jpg
runs/**/*.jpeg
runs/**/*.webp
runs/**/*.gif
runs/**/*.mp4

# Browser/UI verification screenshots at the project root.
*-preview.png
*-verified.png
*-final.png
*-first-touch.png

# Public-repo safety: keep asset manifests/metadata, not raw local or scraped
# image corpora. These can be restored locally or moved to controlled storage.
datasets/no-rarity-lab/assets/
test-fixtures/
screenshots/
