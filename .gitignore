# macOS / editor noise
.DS_Store
*.swp
*.swo
*.log

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# JavaScript / package managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local API/model/data caches
.cache/

# Foundry / local EVM build artifacts
chain/cache/
chain/out/
chain/broadcast/
chain/.gas-snapshot

# Bulky generated simulation artifacts.
# Keep reports, summaries, selected trades, and markdown pressure notes trackable.
runs/**/*.jsonl
runs/**/*.png
runs/**/*.jpg
runs/**/*.jpeg
runs/**/*.webp
runs/**/*.gif
runs/**/*.mp4

# Browser/UI verification screenshots at the project root.
*-preview.png
*-verified.png
*-final.png
*-first-touch.png

# Public-repo safety: keep research corpora out of the public tree. Catalogue
# reference images under web/public/assets are intentionally tracked so Cairn
# never depends on a third-party image host at render time.
datasets/no-rarity-lab/assets/
web/public/sample-alpha.jpg
test-fixtures/
screenshots/
