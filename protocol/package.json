{
  "name": "@cairn/protocol-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "README.md",
    "docs",
    "dist",
    "fixtures",
    "lib",
    "manifest.json",
    "minimum-trust-kernel.json",
    "mutations",
    "operations",
    "npm-shrinkwrap.json",
    "package.json",
    "reference-service",
    "release",
    "schemas",
    "scripts",
    "tests",
    "vectors"
  ],
  "scripts": {
    "build:foundation": "python3 scripts/check-json-sources.py && node scripts/build-bundle.mjs",
    "build": "npm run build:foundation && node scripts/build-minimum-kernel.mjs",
    "check": "python3 scripts/check-json-sources.py && node scripts/check-bundle.mjs && node scripts/check-minimum-kernel.mjs",
    "test:unit": "npm run check && node --test tests/*.test.mjs",
    "test:mutations": "node scripts/run-security-mutants.mjs",
    "test:package": "node scripts/check-packed-package.mjs",
    "test": "npm run test:unit && npm run test:mutations",
    "release:verify": "npm run check && npm test && npm run test:package"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "3.0.0"
  }
}
