{
  "name": "@cairn/protocol-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "python3 scripts/check-json-sources.py && node scripts/build-bundle.mjs",
    "check": "python3 scripts/check-json-sources.py && node scripts/check-bundle.mjs && node scripts/check-minimum-kernel.mjs",
    "test:unit": "npm run build && node --test tests/*.test.mjs",
    "test:mutations": "node scripts/run-security-mutants.mjs",
    "test": "npm run test:unit && npm run test:mutations"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "3.0.0"
  }
}
