{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cairn.cards/protocol/schemas/v0.1/continuation-disclosure-reservation-state.schema.json",
  "title": "Cairn continuation disclosure reservation authoritative state v0.1",
  "x-cairn-kind": "authoritative-state-schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ledger_namespace",
    "reservation_id",
    "ledger_sequence",
    "principal_id",
    "state",
    "fencing_token",
    "single_use_nonce",
    "authorization_ref",
    "authorization_hash",
    "bundle_ref",
    "bundle_hash",
    "recipient_actor_id",
    "runtime_binding_ref",
    "runtime_binding_hash",
    "delivery_envelope_hash",
    "principal_revocation_nonce",
    "data_grant_refs",
    "reserved_count",
    "created_at",
    "expires_at",
    "consumed_at"
  ],
  "properties": {
    "schema": { "const": "cairn.continuation_disclosure_reservation_state.v0.1" },
    "ledger_namespace": { "type": "string", "minLength": 1, "maxLength": 256 },
    "reservation_id": { "$ref": "common.schema.json#/$defs/uuidUrn" },
    "ledger_sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740990 },
    "principal_id": { "$ref": "common.schema.json#/$defs/principalId" },
    "state": { "enum": ["active", "consumed", "released", "expired"] },
    "fencing_token": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "single_use_nonce": { "type": "string", "minLength": 16, "maxLength": 256 },
    "authorization_ref": { "$ref": "common.schema.json#/$defs/objectRef" },
    "authorization_hash": { "$ref": "common.schema.json#/$defs/sha256" },
    "bundle_ref": { "$ref": "common.schema.json#/$defs/objectRef" },
    "bundle_hash": { "$ref": "common.schema.json#/$defs/sha256" },
    "recipient_actor_id": { "$ref": "common.schema.json#/$defs/actorId" },
    "runtime_binding_ref": { "$ref": "common.schema.json#/$defs/objectRef" },
    "runtime_binding_hash": { "$ref": "common.schema.json#/$defs/sha256" },
    "delivery_envelope_hash": { "$ref": "common.schema.json#/$defs/sha256" },
    "principal_revocation_nonce": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "data_grant_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "common.schema.json#/$defs/objectRef" },
      "uniqueItems": true
    },
    "reserved_count": { "const": 1 },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "expires_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "consumed_at": { "$ref": "common.schema.json#/$defs/nullableTimestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "consumed" } }, "required": ["state"] },
      "then": { "properties": { "consumed_at": { "$ref": "common.schema.json#/$defs/timestamp" } } },
      "else": { "properties": { "consumed_at": { "type": "null" } } }
    }
  ]
}
