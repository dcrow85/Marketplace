{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cairn.cards/protocol/schemas/v0.1/operation-bodies.schema.json",
  "title": "Cairn foundation operation bodies v0.1",
  "x-cairn-kind": "operation-body-definitions",
  "$defs": {
    "emptyRequest": {
      "type": "object",
      "additionalProperties": false
    },
    "objectRefRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "retrieval_uri"],
      "properties": {
        "ref": { "$ref": "common.schema.json#/$defs/objectRef" },
        "retrieval_uri": { "$ref": "common.schema.json#/$defs/httpsUri" }
      }
    },
    "capabilitiesResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "profile", "bundle_hash", "operations"],
      "properties": {
        "protocol_version": { "const": "0.1" },
        "profile": { "const": "cairn-proposal-foundation-v0.1" },
        "bundle_hash": { "$ref": "common.schema.json#/$defs/sha256" },
        "operations": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "prefixItems": [
            { "const": "capabilities.get" },
            { "const": "runtime_binding.get" },
            { "const": "intent.put" },
            { "const": "intent.get" },
            { "const": "data_grant.get" },
            { "const": "projection.get" },
            { "const": "object.resolve" },
            { "const": "action.prepare" },
            { "const": "action.get" },
            { "const": "receipt.get" }
          ],
          "items": false
        }
      }
    },
    "idempotencyRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "result_ref"],
      "properties": {
        "fingerprint": { "$ref": "common.schema.json#/$defs/sha256" },
        "result_ref": { "$ref": "common.schema.json#/$defs/objectRef" }
      }
    },
    "storedObjectResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "receipt_ref"],
      "properties": {
        "ref": { "$ref": "common.schema.json#/$defs/objectRef" },
        "receipt_ref": { "$ref": "common.schema.json#/$defs/nullableObjectRef" }
      }
    },
    "resolvedObjectResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "retrieval_uri", "object"],
      "properties": {
        "ref": { "$ref": "common.schema.json#/$defs/objectRef" },
        "retrieval_uri": { "$ref": "common.schema.json#/$defs/httpsUri" },
        "object": { "type": "object" }
      }
    }
  }
}
