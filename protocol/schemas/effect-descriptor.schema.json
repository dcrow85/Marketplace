{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cairn.cards/protocol/schemas/v0.1/effect-descriptor.schema.json",
  "title": "Cairn effect descriptor v0.1",
  "type": "object",
  "additionalProperties": false,
  "x-cairn-object-schema": "cairn.effect_descriptor.v0.1",
  "x-cairn-object-id-pointer": "/effect_descriptor_id",
  "x-cairn-self-hash-pointer": "/descriptor_hash",
  "x-cairn-signature-pointers": ["/descriptor_issuer_signature"],
  "x-cairn-hash-exclusion-pointers": ["/descriptor_issuer_signature/signed_hash", "/descriptor_issuer_signature/value"],
  "x-cairn-semantic-hash": {
    "source_pointer": "/effect_semantics",
    "target_pointer": "/effect_id"
  },
  "required": [
    "schema",
    "effect_descriptor_id",
    "executor_target",
    "effect_semantics",
    "effect_id",
    "descriptor_hash",
    "descriptor_issuer_signature",
    "not_claiming"
  ],
  "properties": {
    "schema": { "const": "cairn.effect_descriptor.v0.1" },
    "effect_descriptor_id": { "$ref": "common.schema.json#/$defs/uuidUrn" },
    "executor_target": { "$ref": "common.schema.json#/$defs/actorId" },
    "effect_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "capability",
        "operation_kind",
        "provider_id",
        "ultimate_receiver",
        "deal_id",
        "closed_terms_or_cart_hash",
        "copy_ids",
        "rail",
        "amounts_by_role"
      ],
      "properties": {
        "principal_id": { "$ref": "common.schema.json#/$defs/principalId" },
        "capability": { "$ref": "common.schema.json#/$defs/capability" },
        "operation_kind": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$" },
        "provider_id": { "$ref": "common.schema.json#/$defs/actorId" },
        "ultimate_receiver": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["canonical_identity", "account_commitment"],
              "properties": {
                "canonical_identity": { "type": "string", "minLength": 1, "maxLength": 512 },
                "account_commitment": { "$ref": "common.schema.json#/$defs/nullableSha256" }
              }
            },
            { "type": "null" }
          ]
        },
        "deal_id": { "$ref": "common.schema.json#/$defs/nullableUuidUrn" },
        "closed_terms_or_cart_hash": { "$ref": "common.schema.json#/$defs/nullableSha256" },
        "copy_ids": {
          "type": "array",
          "maxItems": 10000,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 },
          "uniqueItems": true,
          "x-cairn-utf8-sorted": true
        },
        "rail": {
          "anyOf": [
            { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]{1,127}$" },
            { "type": "null" }
          ]
        },
        "amounts_by_role": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]{1,63}$" },
          "additionalProperties": { "$ref": "common.schema.json#/$defs/money" }
        }
      }
    },
    "effect_id": { "$ref": "common.schema.json#/$defs/sha256" },
    "descriptor_hash": { "$ref": "common.schema.json#/$defs/sha256" },
    "descriptor_issuer_signature": { "$ref": "common.schema.json#/$defs/signature" },
    "not_claiming": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "const": "receiver_effect" },
        { "const": "authority_to_act" },
        { "const": "global_exactly_once" }
      ],
      "items": false
    }
  }
}
