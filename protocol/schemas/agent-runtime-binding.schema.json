{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cairn.cards/protocol/schemas/v0.1/agent-runtime-binding.schema.json",
  "title": "Cairn agent runtime binding v0.1",
  "type": "object",
  "additionalProperties": false,
  "x-cairn-object-schema": "cairn.agent_runtime_binding.v0.1",
  "x-cairn-object-id-pointer": "/runtime_binding_id",
  "x-cairn-self-hash-pointer": "/runtime_binding_hash",
  "x-cairn-signature-pointers": ["/provider_signature"],
  "x-cairn-hash-exclusion-pointers": ["/provider_signature/signed_hash", "/provider_signature/value"],
  "x-cairn-equal-non-null-pointers": [["/agent_identity/runtime_instance_key_id", "/runtime_public_key/key_id"]],
  "required": [
    "schema",
    "runtime_binding_id",
    "agent_identity",
    "runtime_public_key",
    "key_status",
    "not_before",
    "expires_at",
    "runtime_binding_hash",
    "provider_signature",
    "not_claiming"
  ],
  "properties": {
    "schema": { "const": "cairn.agent_runtime_binding.v0.1" },
    "runtime_binding_id": { "$ref": "common.schema.json#/$defs/uuidUrn" },
    "agent_identity": { "$ref": "common.schema.json#/$defs/agentIdentity" },
    "runtime_public_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "key_id", "public_key"],
      "properties": {
        "profile": { "const": "cairn-ed25519-v0.1" },
        "key_id": { "type": "string", "format": "uri-reference", "minLength": 1 },
        "public_key": { "type": "string", "format": "cairn-ed25519-public-key" }
      }
    },
    "key_status": { "enum": ["active", "suspended", "revoked", "expired"] },
    "not_before": { "$ref": "common.schema.json#/$defs/timestamp" },
    "expires_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "runtime_binding_hash": { "$ref": "common.schema.json#/$defs/sha256" },
    "provider_signature": { "$ref": "common.schema.json#/$defs/signature" },
    "not_claiming": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "const": "model_or_policy_attestation" },
        { "const": "principal_authority" },
        { "const": "personhood" }
      ],
      "items": false
    }
  }
}
