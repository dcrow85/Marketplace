{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cairn.cards/protocol/schemas/v0.1/data-grant.schema.json",
  "title": "Cairn data grant v0.1",
  "type": "object",
  "additionalProperties": false,
  "x-cairn-object-schema": "cairn.data_grant.v0.1",
  "x-cairn-object-id-pointer": "/grant_id",
  "x-cairn-self-hash-pointer": "/grant_hash",
  "x-cairn-signature-pointers": ["/principal_signature"],
  "x-cairn-hash-exclusion-pointers": ["/principal_signature/signed_hash", "/principal_signature/value"],
  "required": [
    "schema",
    "grant_id",
    "principal_id",
    "recipient",
    "resource_scopes",
    "uses",
    "purpose",
    "audience",
    "maximum_disclosures",
    "retention",
    "revocation_nonce",
    "disclosure_ledger_namespace",
    "issued_at",
    "expires_at",
    "grant_hash",
    "principal_signature",
    "not_claiming"
  ],
  "properties": {
    "schema": { "const": "cairn.data_grant.v0.1" },
    "grant_id": { "$ref": "common.schema.json#/$defs/uuidUrn" },
    "principal_id": { "$ref": "common.schema.json#/$defs/principalId" },
    "recipient": { "$ref": "common.schema.json#/$defs/actorId" },
    "resource_scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource_kind", "ref", "retrieval_uri", "field_paths"],
        "properties": {
          "resource_kind": { "enum": ["object", "runtime_binding", "schema_bundle", "service_manifest", "control_head", "grant_head", "service_endpoint"] },
          "ref": { "$ref": "common.schema.json#/$defs/nullableObjectRef" },
          "retrieval_uri": { "$ref": "common.schema.json#/$defs/httpsUri" },
          "field_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "anyOf": [
                { "const": "" },
                { "type": "string", "pattern": "^/(?:[^~/]|~0|~1)+(?:/(?:[^~/]|~0|~1)+)*$" }
              ]
            },
            "uniqueItems": true
          }
        }
      }
    },
    "uses": { "type": "array", "minItems": 1, "items": { "enum": ["read_local", "derive", "disclose_to_audience", "retain_until_expiry", "write_object"] }, "uniqueItems": true },
    "purpose": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,95}$" },
    "audience": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/actorId" }, "uniqueItems": true },
    "maximum_disclosures": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expires_at", "deletion_terms"],
      "properties": {
        "expires_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "deletion_terms": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "revocation_nonce": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "disclosure_ledger_namespace": { "type": "string", "minLength": 1, "maxLength": 256 },
    "issued_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "expires_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "grant_hash": { "$ref": "common.schema.json#/$defs/sha256" },
    "principal_signature": { "$ref": "common.schema.json#/$defs/signature" },
    "not_claiming": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [{ "const": "external_deletion_enforced" }],
      "items": false
    }
  }
}
