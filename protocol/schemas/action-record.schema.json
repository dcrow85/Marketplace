{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cairn.cards/protocol/schemas/v0.1/action-record.schema.json",
  "title": "Cairn action record v0.1",
  "type": "object",
  "additionalProperties": false,
  "x-cairn-object-schema": "cairn.action_record.v0.1",
  "x-cairn-object-id-pointer": "/action_id",
  "x-cairn-self-hash-pointer": "/action_hash",
  "x-cairn-signature-pointers": ["/action_service_signature"],
  "x-cairn-hash-exclusion-pointers": ["/action_service_signature/signed_hash", "/action_service_signature/value"],
  "required": [
    "schema",
    "action_id",
    "action_proposal_ref",
    "principal_id",
    "capability",
    "authorization_ref",
    "reservation_refs",
    "gate_result_ref",
    "expected_deal_head_hash",
    "effect_id",
    "idempotency_key",
    "current_state",
    "state_version",
    "last_transition_receipt_ref",
    "previous_action_ref",
    "materialized_from_receipt_hash",
    "created_at",
    "updated_at",
    "action_hash",
    "action_service_signature",
    "not_claiming"
  ],
  "properties": {
    "schema": { "const": "cairn.action_record.v0.1" },
    "action_id": { "$ref": "common.schema.json#/$defs/uuidUrn" },
    "action_proposal_ref": { "$ref": "common.schema.json#/$defs/objectRef" },
    "principal_id": { "$ref": "common.schema.json#/$defs/principalId" },
    "capability": { "$ref": "common.schema.json#/$defs/capability" },
    "authorization_ref": { "$ref": "common.schema.json#/$defs/nullableObjectRef" },
    "reservation_refs": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "common.schema.json#/$defs/objectRef" },
      "uniqueItems": true
    },
    "gate_result_ref": { "$ref": "common.schema.json#/$defs/nullableObjectRef" },
    "expected_deal_head_hash": { "$ref": "common.schema.json#/$defs/nullableSha256" },
    "effect_id": { "$ref": "common.schema.json#/$defs/sha256" },
    "idempotency_key": { "type": "string", "minLength": 16, "maxLength": 256 },
    "current_state": {
      "enum": [
        "draft",
        "prepared",
        "authorization_pending",
        "authorized",
        "reserved",
        "redemption_committed",
        "submitted",
        "acknowledged",
        "finalized",
        "failed",
        "unknown",
        "cancelled",
        "expired"
      ]
    },
    "state_version": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "last_transition_receipt_ref": { "$ref": "common.schema.json#/$defs/nullableObjectRef" },
    "previous_action_ref": { "$ref": "common.schema.json#/$defs/nullableObjectRef" },
    "materialized_from_receipt_hash": { "$ref": "common.schema.json#/$defs/nullableSha256" },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "updated_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "action_hash": { "$ref": "common.schema.json#/$defs/sha256" },
    "action_service_signature": { "$ref": "common.schema.json#/$defs/signature" },
    "not_claiming": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [{ "const": "receiver_effect_before_confirmation" }],
      "items": false
    }
  }
}
