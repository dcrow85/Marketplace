{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cairn.cards/protocol/schemas/v0.1/continuation-disclosure-authorization.schema.json",
  "title": "Cairn continuation disclosure authorization v0.1",
  "type": "object",
  "additionalProperties": false,
  "x-cairn-object-schema": "cairn.continuation_disclosure_authorization.v0.1",
  "x-cairn-object-id-pointer": "/authorization_id",
  "x-cairn-self-hash-pointer": "/authorization_hash",
  "x-cairn-signature-pointers": ["/principal_signature"],
  "x-cairn-hash-exclusion-pointers": ["/principal_signature/signed_hash", "/principal_signature/value"],
  "required": [
    "schema",
    "authorization_id",
    "principal_id",
    "recipient_actor_id",
    "recipient_runtime_binding_ref",
    "recipient_runtime_binding_hash",
    "bundle_ref",
    "bundle_hash",
    "delivery_envelope_hash",
    "disclosure_reservation",
    "data_grant_refs",
    "purpose",
    "one_shot",
    "issued_at",
    "expires_at",
    "authorization_hash",
    "principal_signature",
    "not_claiming"
  ],
  "properties": {
    "schema": { "const": "cairn.continuation_disclosure_authorization.v0.1" },
    "authorization_id": { "$ref": "common.schema.json#/$defs/uuidUrn" },
    "principal_id": { "$ref": "common.schema.json#/$defs/principalId" },
    "recipient_actor_id": { "$ref": "common.schema.json#/$defs/actorId" },
    "recipient_runtime_binding_ref": { "$ref": "common.schema.json#/$defs/objectRef" },
    "recipient_runtime_binding_hash": { "$ref": "common.schema.json#/$defs/sha256" },
    "bundle_ref": { "$ref": "common.schema.json#/$defs/objectRef" },
    "bundle_hash": { "$ref": "common.schema.json#/$defs/sha256" },
    "delivery_envelope_hash": { "$ref": "common.schema.json#/$defs/sha256" },
    "disclosure_reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledger_namespace", "reservation_id", "fencing_token", "principal_revocation_nonce", "single_use_nonce"],
      "properties": {
        "ledger_namespace": { "type": "string", "minLength": 1, "maxLength": 256 },
        "reservation_id": { "$ref": "common.schema.json#/$defs/uuidUrn" },
        "fencing_token": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "principal_revocation_nonce": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "single_use_nonce": { "type": "string", "minLength": 16, "maxLength": 256 }
      }
    },
    "data_grant_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "common.schema.json#/$defs/objectRef" },
      "uniqueItems": true
    },
    "purpose": { "const": "agent_continuation" },
    "one_shot": { "const": true },
    "issued_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "expires_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "authorization_hash": { "$ref": "common.schema.json#/$defs/sha256" },
    "principal_signature": { "$ref": "common.schema.json#/$defs/signature" },
    "not_claiming": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "const": "authority_transfer" },
        { "const": "mandate_transfer" }
      ],
      "items": false
    }
  }
}
