{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cairn.cards/protocol/schemas/v0.1/envelope.schema.json",
  "title": "Cairn signed message envelope v0.1",
  "type": "object",
  "additionalProperties": false,
  "x-cairn-object-schema": "cairn.envelope.v0.1",
  "x-cairn-object-id-pointer": "/message_id",
  "x-cairn-self-hash-pointer": "/envelope_hash",
  "x-cairn-signature-pointers": ["/signature"],
  "x-cairn-hash-exclusion-pointers": ["/signature/signed_hash", "/signature/value"],
  "x-cairn-equal-non-null-pointers": [["/sender/runtime_key_id", "/signature/key_id"]],
  "x-cairn-body-hash": { "source_pointer": "/body", "target_pointer": "/body_hash" },
  "required": [
    "schema",
    "protocol_version",
    "message_id",
    "message_type",
    "created_at",
    "expires_at",
    "sender",
    "principal_id",
    "audience",
    "subject_refs",
    "authorization_refs",
    "nonce",
    "idempotency_key",
    "operation_fingerprint",
    "critical_extensions",
    "body_schema",
    "body",
    "body_hash",
    "trace",
    "envelope_hash",
    "signature"
  ],
  "properties": {
    "schema": { "const": "cairn.envelope.v0.1" },
    "protocol_version": { "const": "0.1" },
    "message_id": { "$ref": "common.schema.json#/$defs/uuidUrn" },
    "message_type": {
      "enum": [
        "capabilities.get",
        "runtime_binding.get",
        "intent.put",
        "intent.get",
        "data_grant.get",
        "projection.get",
        "object.resolve",
        "action.prepare",
        "receipt.get"
      ]
    },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "expires_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "sender": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "runtime_key_id"],
      "properties": {
        "actor_id": { "$ref": "common.schema.json#/$defs/actorId" },
        "runtime_key_id": {
          "anyOf": [
            { "type": "string", "format": "uri-reference", "minLength": 1 },
            { "type": "null" }
          ]
        }
      }
    },
    "principal_id": {
      "anyOf": [
        { "$ref": "common.schema.json#/$defs/principalId" },
        { "type": "null" }
      ]
    },
    "audience": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "common.schema.json#/$defs/actorId" },
      "uniqueItems": true
    },
    "subject_refs": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "common.schema.json#/$defs/objectRef" },
      "uniqueItems": true
    },
    "authorization_refs": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "common.schema.json#/$defs/objectRef" },
      "uniqueItems": true
    },
    "nonce": { "type": "string", "minLength": 16, "maxLength": 256 },
    "idempotency_key": {
      "anyOf": [
        { "type": "string", "minLength": 16, "maxLength": 256 },
        { "type": "null" }
      ]
    },
    "operation_fingerprint": { "$ref": "common.schema.json#/$defs/sha256" },
    "critical_extensions": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "format": "uri" },
      "uniqueItems": true
    },
    "body_schema": { "type": "string", "format": "uri-reference", "minLength": 1 },
    "body": { "type": "object" },
    "body_hash": { "$ref": "common.schema.json#/$defs/sha256" },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_message_id", "correlation_id"],
      "properties": {
        "parent_message_id": { "$ref": "common.schema.json#/$defs/nullableUuidUrn" },
        "correlation_id": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "envelope_hash": { "$ref": "common.schema.json#/$defs/sha256" },
    "signature": { "$ref": "common.schema.json#/$defs/signature" }
  }
}
