{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cairn.cards/protocol/schemas/v0.1/continuation-bundle.schema.json",
  "title": "Cairn continuation bundle v0.1",
  "type": "object",
  "additionalProperties": false,
  "x-cairn-object-schema": "cairn.continuation_bundle.v0.1",
  "x-cairn-self-hash-pointer": "/bundle_hash",
  "x-cairn-signature-pointers": ["/issuer_signature"],
  "required": [
    "schema",
    "bundle_id",
    "principal_id",
    "recipient_runtime_binding",
    "schema_bundle",
    "object_service_manifest",
    "items",
    "current_intent_control_heads",
    "current_deal_heads",
    "current_action_reservation_service_refs",
    "current_grant_status_and_revocation_refs",
    "unresolved_unknown_refs",
    "issued_at",
    "expires_at",
    "bundle_hash",
    "issuer_signature",
    "not_claiming"
  ],
  "properties": {
    "schema": { "const": "cairn.continuation_bundle.v0.1" },
    "bundle_id": { "$ref": "common.schema.json#/$defs/uuidUrn" },
    "principal_id": { "$ref": "common.schema.json#/$defs/principalId" },
    "recipient_runtime_binding": { "$ref": "common.schema.json#/$defs/privateAuthorizedRef" },
    "schema_bundle": { "$ref": "common.schema.json#/$defs/authorizedRef" },
    "object_service_manifest": { "$ref": "common.schema.json#/$defs/authorizedRef" },
    "items": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "retrieval_uri", "data_grant_ref", "required_for"],
        "properties": {
          "ref": { "$ref": "common.schema.json#/$defs/objectRef" },
          "retrieval_uri": { "$ref": "common.schema.json#/$defs/httpsUri" },
          "data_grant_ref": { "$ref": "common.schema.json#/$defs/objectRef" },
          "required_for": { "enum": ["state", "source", "unknown", "legal_next_action"] }
        }
      }
    },
    "current_intent_control_heads": { "$ref": "#/$defs/privateRefList" },
    "current_deal_heads": { "$ref": "#/$defs/privateRefList" },
    "current_action_reservation_service_refs": { "$ref": "#/$defs/privateRefList" },
    "current_grant_status_and_revocation_refs": { "$ref": "#/$defs/privateRefList" },
    "unresolved_unknown_refs": { "$ref": "#/$defs/privateRefList" },
    "issued_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "expires_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "bundle_hash": { "$ref": "common.schema.json#/$defs/sha256" },
    "issuer_signature": { "$ref": "common.schema.json#/$defs/signature" },
    "not_claiming": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [{ "const": "authority_transfer" }],
      "items": false
    }
  },
  "$defs": {
    "privateRefList": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "common.schema.json#/$defs/privateAuthorizedRef" },
      "uniqueItems": true
    }
  }
}
