{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cairn.cards/protocol/schemas/v0.1/action-preparation-receipt.schema.json",
  "title": "Cairn action preparation receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "x-cairn-object-schema": "cairn.action_preparation_receipt.v0.1",
  "x-cairn-self-hash-pointer": "/receipt_hash",
  "x-cairn-signature-pointers": ["/issuer_signature"],
  "required": [
    "schema",
    "receipt_id",
    "action_ref",
    "action_proposal_ref",
    "state_before",
    "state_after",
    "prepared_for_principal",
    "prepared_by_agent",
    "external_effect",
    "issued_at",
    "issuer",
    "prior_receipt_or_event_hash",
    "receipt_hash",
    "issuer_signature",
    "not_claiming"
  ],
  "properties": {
    "schema": { "const": "cairn.action_preparation_receipt.v0.1" },
    "receipt_id": { "$ref": "common.schema.json#/$defs/uuidUrn" },
    "action_ref": { "$ref": "common.schema.json#/$defs/objectRef" },
    "action_proposal_ref": { "$ref": "common.schema.json#/$defs/objectRef" },
    "state_before": { "const": "draft" },
    "state_after": { "const": "prepared" },
    "prepared_for_principal": { "$ref": "common.schema.json#/$defs/principalId" },
    "prepared_by_agent": { "$ref": "common.schema.json#/$defs/agentIdentity" },
    "external_effect": { "const": false },
    "issued_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "issuer": { "$ref": "common.schema.json#/$defs/actorId" },
    "prior_receipt_or_event_hash": { "$ref": "common.schema.json#/$defs/nullableSha256" },
    "receipt_hash": { "$ref": "common.schema.json#/$defs/sha256" },
    "issuer_signature": { "$ref": "common.schema.json#/$defs/signature" },
    "not_claiming": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "const": "authority_to_act" },
        { "const": "external_effect" }
      ],
      "items": false
    }
  }
}
