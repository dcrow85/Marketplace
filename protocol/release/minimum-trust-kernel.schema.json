{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cairn.cards/protocol/release/minimum-trust-kernel.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kernel_id",
    "profile",
    "release_status",
    "foundation_bundle_hash",
    "operation_registry_hash",
    "included_operations",
    "allowed_object_store_mutations",
    "operation_state_effects",
    "byo_prerequisites",
    "forbidden_operation_terms",
    "excluded_profiles",
    "next_profile_requires",
    "conformance_claims",
    "not_claiming"
  ],
  "properties": {
    "schema": { "const": "cairn.minimum_trust_kernel_manifest.v0.1" },
    "kernel_id": { "const": "cairn-agent-minimum-trust-kernel-v0.1" },
    "profile": { "const": "cairn-proposal-foundation-v0.1" },
    "release_status": { "const": "active_narrowed_candidate" },
    "foundation_bundle_hash": {
      "const": "sha-256:00e379db20f5557adc5ab1a31f3d60acdc7c038e5fe375ed8571bd1048c05a24"
    },
    "operation_registry_hash": {
      "const": "sha-256:71775e969dbfea218dffa45aa396282c7bd039a8e51863a8920a45976234b91d"
    },
    "included_operations": {
      "const": [
        "capabilities.get",
        "runtime_binding.get",
        "intent.put",
        "intent.get",
        "data_grant.get",
        "projection.get",
        "object.resolve",
        "action.prepare",
        "action.get",
        "receipt.get"
      ]
    },
    "allowed_object_store_mutations": {
      "const": [
        {
          "operation": "intent.put",
          "authority_effect": "records_principal_signed_intent_only"
        },
        {
          "operation": "action.prepare",
          "authority_effect": "none"
        }
      ]
    },
    "operation_state_effects": {
      "const": [
        {
          "operation": "capabilities.get",
          "object_store_mutating": false,
          "access_state_effects": [],
          "signed_envelope_effects": ["consume_replay_nonce"]
        },
        {
          "operation": "runtime_binding.get",
          "object_store_mutating": false,
          "access_state_effects": [],
          "signed_envelope_effects": ["consume_replay_nonce"]
        },
        {
          "operation": "intent.put",
          "object_store_mutating": true,
          "access_state_effects": ["consume_grant_disclosure_budget"],
          "signed_envelope_effects": ["consume_replay_nonce", "write_idempotency_record"]
        },
        {
          "operation": "intent.get",
          "object_store_mutating": false,
          "access_state_effects": ["consume_grant_disclosure_budget"],
          "signed_envelope_effects": ["consume_replay_nonce"]
        },
        {
          "operation": "data_grant.get",
          "object_store_mutating": false,
          "access_state_effects": ["consume_grant_disclosure_budget"],
          "signed_envelope_effects": ["consume_replay_nonce"]
        },
        {
          "operation": "projection.get",
          "object_store_mutating": false,
          "access_state_effects": ["consume_grant_disclosure_budget"],
          "signed_envelope_effects": ["consume_replay_nonce"]
        },
        {
          "operation": "object.resolve",
          "object_store_mutating": false,
          "access_state_effects": ["consume_grant_disclosure_budget"],
          "signed_envelope_effects": ["consume_replay_nonce"]
        },
        {
          "operation": "action.prepare",
          "object_store_mutating": true,
          "access_state_effects": ["consume_grant_disclosure_budget"],
          "signed_envelope_effects": ["consume_replay_nonce", "write_idempotency_record"]
        },
        {
          "operation": "action.get",
          "object_store_mutating": false,
          "access_state_effects": ["consume_grant_disclosure_budget"],
          "signed_envelope_effects": ["consume_replay_nonce"]
        },
        {
          "operation": "receipt.get",
          "object_store_mutating": false,
          "access_state_effects": ["consume_grant_disclosure_budget"],
          "signed_envelope_effects": ["consume_replay_nonce"]
        }
      ]
    },
    "byo_prerequisites": {
      "const": [
        "preprovisioned_authenticated_runtime_binding",
        "principal_bound_exact_runtime_data_grants_and_state",
        "authenticated_object_ref_and_uri_handoff",
        "signing_key_resolution_profile",
        "available_authenticated_proposal_foundation_service_endpoint_and_transport_profile"
      ]
    },
    "forbidden_operation_terms": {
      "const": [
        "authorize",
        "execute",
        "dispatch",
        "pay",
        "payment",
        "settle",
        "release",
        "waive",
        "issue"
      ]
    },
    "excluded_profiles": {
      "const": ["cairn-supervised-execution-v0.1"]
    },
    "next_profile_requires": {
      "const": [
        "signed_service_read_snapshot",
        "authenticated_service_key_profile",
        "exact_dependency_semantics",
        "independent_frozen_review"
      ]
    },
    "conformance_claims": { "const": [] },
    "not_claiming": {
      "const": [
        "production_service",
        "runtime_conformance",
        "authority_to_act",
        "external_effect",
        "authorization",
        "execution",
        "payment",
        "settlement",
        "release",
        "waiver",
        "authenticated_service_observation",
        "agent_onboarding",
        "grant_issuance",
        "object_reference_discovery",
        "continuation_delivery",
        "service_availability",
        "transport_binding_conformance"
      ]
    }
  }
}
